package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_tv_os",
}

prebuilt_etc {
    name: "privapp_extension_com.android.systemui",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "com.android.systemui_extension.xml",
    filename_from_src: true,
}

android_library {
    name: "TvSystemUI-res",
    resource_dirs: [
        "res",
    ],
    manifest: "AndroidManifest-res.xml",
    use_resource_processor: true,
}

android_library {
    name: "TvSystemUI-core",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    resource_dirs: [],
    use_resource_processor: true,
    static_libs: [
        "SystemUI-application",
        "SystemUI-core",
        "SystemUIPluginLib",
        "SystemUISharedLib",
        "SystemUI-shared-utils",
        "TvSystemUI-res",
        "TwoPanelSettingsLib",
        // AppFunctions
        "androidx.appfunctions_appfunctions",
        "androidx.appfunctions_appfunctions-service",
    ],
    javacflags: ["-Adagger.fastInit=enabled"],
    platform_apis: true,
    system_ext_specific: true,
    manifest: "AndroidManifest.xml",
    additional_manifests: ["AndroidManifest-exclude-overrides.xml"],
    plugins: [
        "dagger2-compiler",
        "androidx.appfunctions_appfunctions-compiler-plugin",
    ],
    enable_ksp: true,
    annotation_processor_flags: [
        "appfunctions\\\\:aggregateAppFunctions=true",
    ],
    optional_uses_libs: ["com.android.extensions.appfunctions"],
}

android_app {
    name: "TvSystemUI",
    defaults: [
        "platform_app_defaults",
        "SystemUI_optimized_defaults",
        "wmshell_defaults",
    ],
    static_libs: [
        "TvSystemUI-core",
    ],
    overrides: [
        "SystemUI",
    ],
    resource_dirs: [],
    use_resource_processor: true,

    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,

    kotlincflags: ["-Xjvm-default=all"],

    dxflags: ["--multi-dex"],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
        included_proguard_flags_files: [":sysui_proguard_common_and_kotlin"],
    },
    required: [
        "privapp_whitelist_com.android.systemui",
        "privapp_extension_com.android.systemui",
    ],
}
